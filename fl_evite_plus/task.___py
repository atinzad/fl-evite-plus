# fl_evite_plus/task.py

import os
import random
import json

import numpy as np
from flwr_datasets import FederatedDataset
from flwr_datasets.partitioner import IidPartitioner
from sklearn.linear_model import SGDClassifier
from flwr.common import Parameters, parameters_to_ndarrays

# ── GLOBALS ───────────────────────────────────────────────────────────────────
fds = None  # Cache FederatedDataset
LABEL_ASSIGNMENTS_LOG = "label_assignments_log.json"
label_assignments: dict[str, list[int]] = {}

# Load existing mapping if present
if os.path.isfile(LABEL_ASSIGNMENTS_LOG):
    with open(LABEL_ASSIGNMENTS_LOG, "r") as f:
        label_assignments = json.load(f)


def get_client_labels(cid: int, k: int, seed: int = 42) -> list[int]:
    """
    Return exactly k distinct MNIST labels (0–9) for client `cid`.
    Uses random.seed(cid + seed) for reproducibility per client.
    If no assignment exists on disk for this cid and k, pick a new sample of size k,
    then save to LABEL_ASSIGNMENTS_LOG.
    """
    global label_assignments

    key = f"{cid}-{k}"
    if key in label_assignments:
        return label_assignments[key]

    random.seed(cid + seed)
    chosen_labels = sorted(random.sample(range(10), k))
    label_assignments[key] = chosen_labels

    with open(LABEL_ASSIGNMENTS_LOG, "w") as f:
        json.dump(label_assignments, f, indent=2)

    return chosen_labels


def load_full_test_data(num_parts: int = 10):
    """
    Stack together each partition’s TEST set into one big (X_all, y_all).
    We pass allowed_labels=list(range(10)) to get the full unfiltered test.
    """
    X_all, y_all = [], []
    for pid in range(num_parts):
        _, X_test, _, y_test = load_data(pid, num_parts, allowed_labels=list(range(10)))
        X_all.append(X_test)
        y_all.append(y_test)
    return np.vstack(X_all), np.concatenate(y_all)


def load_data(partition_id: int, num_partitions: int, allowed_labels: list[int]):
    """
    Load partitioned MNIST data, then filter so that this client only sees its allowed_labels.
    Returns:
        X_train_filtered, X_test_filtered, y_train_filtered, y_test_filtered
    """
    global fds

    # 1) Initialize FederatedDataset once
    if fds is None:
        partitioner = IidPartitioner(num_partitions=num_partitions)
        fds = FederatedDataset(
            dataset="mnist",
            partitioners={"train": partitioner},
        )

    # 2) Load the full partition (train+test) as numpy arrays
    dataset = fds.load_partition(partition_id, "train").with_format("numpy")
    X = dataset["image"].reshape((len(dataset), -1))
    y = dataset["label"]

    # 3) Split into 80% train / 20% test
    split_idx = int(0.8 * len(X))
    X_train_full, X_test_full = X[:split_idx], X[split_idx:]
    y_train_full, y_test_full = y[:split_idx], y[split_idx:]

    # 4) Build boolean masks to keep only those allowed_labels
    train_mask = np.isin(y_train_full, allowed_labels)
    test_mask  = np.isin(y_test_full,  allowed_labels)

    # 5) Apply masks
    X_train_filtered = X_train_full[train_mask]
    y_train_filtered = y_train_full[train_mask]
    X_test_filtered  = X_test_full[test_mask]
    y_test_filtered  = y_test_full[test_mask]

    return X_train_filtered, X_test_filtered, y_train_filtered, y_test_filtered


def get_model(penalty: str, local_epochs: int):
    """
    Return a fresh SGDClassifier configured for “logistic regression” (i.e. FedProx‐style).
    We use partial_fit(...) with classes=np.arange(10) below, so the coefficient matrix
    will always remain shape (10, 784).
    """
    # Note: “loss='log_loss'”⇒ standard logistic regression; warm_start is automatic for partial_fit
    return SGDClassifier(
        loss="log_loss",
        penalty=penalty,
        max_iter=1,       # We’ll call partial_fit local_epochs times manually
        learning_rate="optimal",
        tol=None,
        random_state=42,
    )


def get_model_params(model):
    """
    Extract model parameters as a list of ndarrays.
    For SGDClassifier, coef_.shape = (n_classes=10, n_features=784).
    If intercept_ exists, return [coef_, intercept_].
    """
    if model.fit_intercept:
        return [model.coef_, model.intercept_]
    return [model.coef_]


def set_model_params(model, params):
    """
    Given either a Flower Parameters object or a raw list of ndarrays,
    set model.coef_ and model.intercept_ so that warm_start works correctly.
    """
    if isinstance(params, Parameters):
        ndarrays = parameters_to_ndarrays(params)
    else:
        ndarrays = params

    # 1) Extract coef
    coef = np.array(ndarrays[0])
    model.coef_ = coef

    # 2) Extract intercept if needed
    if model.fit_intercept and len(ndarrays) > 1:
        intercept = np.array(ndarrays[1]).reshape(-1)
        model.intercept_ = intercept

    return model


def set_initial_params(model):
    """
    Initialize a new SGDClassifier so that:
      - coef_ = zeros((10, 784))
      - intercept_ = zeros((10,)) if fit_intercept=True
    We also set `classes_` explicitly for use in partial_fit.
    """
    n_classes = 10
    n_features = 784

    # Create a zero‐matrix for coef_ and intercept_
    model.coef_ = np.zeros((n_classes, n_features))
    if model.fit_intercept:
        model.intercept_ = np.zeros((n_classes,))
    # We do NOT need to set model.classes_ manually; partial_fit(...) will accept classes=range(10).
    return model
